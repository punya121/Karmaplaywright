E2E_USERNAME=your_active_username
E2E_PASSWORD=your_active_password
E2E_INACTIVE_USERNAME=your_inactive_username
E2E_INACTIVE_PASSWORD=your_inactive_password
E2E_WRONG_PASSWORD=your_wrong_password
E2E_BASE_URL=https://www.karmaplaywright.com
E2E_DOCTOR_USERNAME=your_doctor_username
E2E_DOCTOR_PASSWORD=your_doctor_password

# Amazon SES — emails Test-Execution-Report.xlsx after each run.
# Leave From/To blank to skip. Sender (and recipients, if SES is in sandbox) must be verified.
E2E_REPORT_EMAIL_FROM=info@karmaprimaryhealthcare.in
E2E_REPORT_EMAIL_TO=qa@example.com,lead@example.com
# E2E_REPORT_EMAIL_CC=manager@example.com
# E2E_REPORT_EMAIL=false
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=your_ses_access_key_id
AWS_SES_SECRET_ACCESS_KEY=your_ses_secret_access_key

# The live two-browser consultation — tests/live/, run with `npm run test:live:headed`.
# Browser 1 is the centre (E2E_USERNAME); at Doctor Selection it opens browser 2 and
# signs in as E2E_DOCTOR_USERNAME. The visit is handed to E2E_DOCTOR_NAME on Doctor
# Selection, so that must be the same doctor the second browser signs in as, or the
# handover lands in somebody else's queue.
# E2E_DOCTOR_NAME=Dr. Demo
# E2E_LIVE_TEST_TIMEOUT=1800000     # the whole run: registration through to the join
# E2E_LIVE_QUEUE_TIMEOUT=180000     # the handed-over visit appearing in the doctor queue
# Where the doctor's window goes, so a watched run shows both browsers side by side.
# E2E_DOCTOR_WINDOW_POSITION=960,0
# E2E_DOCTOR_WINDOW_SIZE=960,1040

# SMILE centre - tests/smile/smile-registration.spec.ts (Registration > Prescription)
E2E_SMILE_USERNAME=
E2E_SMILE_PASSWORD=
