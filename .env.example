E2E_USERNAME=your_active_username
E2E_PASSWORD=your_active_password
E2E_INACTIVE_USERNAME=your_inactive_username
E2E_INACTIVE_PASSWORD=your_inactive_password
E2E_WRONG_PASSWORD=your_wrong_password
E2E_BASE_URL=https://www.karmaplaywright.com
E2E_DOCTOR_USERNAME=your_doctor_username
E2E_DOCTOR_PASSWORD=your_doctor_password

# Amazon SES — emails Test-Execution-Report.xlsx after each run.
# Leave From/To blank to skip. Sender (and recipients, if SES is in sandbox) must be verified.
E2E_REPORT_EMAIL_FROM=info@karmaprimaryhealthcare.in
E2E_REPORT_EMAIL_TO=qa@example.com,lead@example.com
# E2E_REPORT_EMAIL_CC=manager@example.com
# E2E_REPORT_EMAIL=false
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=your_ses_access_key_id
AWS_SES_SECRET_ACCESS_KEY=your_ses_secret_access_key
