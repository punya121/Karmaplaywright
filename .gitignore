
# Playwright
node_modules/
.env
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Test reports — every run is archived under reports/runs/<run id>/
# (HTML report + test-results.json + Test-Execution-Report.xlsx) and the whole
# history stays local. Nothing under reports/ is ever committed.
/reports/

# Excel lock files left behind when a report workbook is open
~$*.xlsx

# Recordings from tools/record.js: raw clicks, and whatever password was typed
# while recording. The tools themselves are committed; their output never is.
/tools/recorded/
